# Copy to .env.production, restrict file permissions, replace every placeholder.
# Pass it to Compose with --env-file .env.production.
BUILD_SHA=replace-with-40-character-git-revision
SITE_DOMAIN=replace.example.test
POSTGRES_PASSWORD=replace-with-a-random-database-password
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=replace.example.test
PUBLIC_WEB_ORIGIN=https://replace.example.test
CORS_ALLOWED_ORIGINS=https://replace.example.test
DJANGO_HSTS_SECONDS=0
DATABASE_URL=postgres://testflow:replace-with-a-random-database-password@db:5432/testflow
REDIS_URL=redis://redis:6379/0
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=replace.smtp.example.test
EMAIL_PORT=587
EMAIL_HOST_USER=replace
EMAIL_HOST_PASSWORD=replace
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=TestFlow <noreply@replace.example.test>
IMPORT_DAILY_JOB_LIMIT=20
IMPORT_INFERENCE_URL=
IMPORT_INFERENCE_TOKEN=
SOFFICE_BIN=/usr/bin/soffice
