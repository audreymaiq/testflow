# Local development placeholders. Copy to .env and replace secrets; never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-dev-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://testflow:testflow_dev_password@127.0.0.1:5432/testflow
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=10/min
THROTTLE_REFRESH=120/min
THROTTLE_LOGOUT=60/min
THROTTLE_TAXONOMY_LOOKUP=60/min
THROTTLE_TAXONOMY_CREATE=20/day
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_PASSWORD_RESET_CONFIRM=10/min
PUBLIC_WEB_ORIGIN=http://localhost:5173
# Production: configure an HTTPS origin, a real mail backend and verified sender.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=TestFlow <noreply@localhost>
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
IMPORT_DAILY_JOB_LIMIT=20
BUILD_SHA=local
VITE_API_BASE_URL=http://localhost:8000/api/v1
