# Local development placeholders. Copy to .env and replace secrets; never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-dev-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://testflow:testflow_dev_password@127.0.0.1:5432/testflow
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=10/min
THROTTLE_REFRESH=120/min
THROTTLE_LOGOUT=60/min
VITE_API_BASE_URL=http://localhost:8000/api/v1
