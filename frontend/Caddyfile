{$SITE_DOMAIN} {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        -Server
    }

    handle /api/* {
        reverse_proxy api:8000
    }

    handle /admin/* {
        reverse_proxy api:8000
    }

    handle /healthz {
        reverse_proxy api:8000
    }

    handle /static/* {
        root * /srv
        file_server
    }

    handle {
        root * /srv/web
        try_files {path} /index.html
        file_server
    }
}
